{
  "name": "car-comfort",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/sequelize-cli.js db:migrate",
    "db:migrate:prod": "NODE_ENV=production node scripts/sequelize-cli.js db:migrate",
    "db:migrate:undo": "node scripts/sequelize-cli.js db:migrate:undo",
    "db:migrate:undo:prod": "NODE_ENV=production node scripts/sequelize-cli.js db:migrate:undo",
    "db:migrate:undo:all": "node scripts/sequelize-cli.js db:migrate:undo:all",
    "db:migrate:undo:all:prod": "NODE_ENV=production node scripts/sequelize-cli.js db:migrate:undo:all",
    "db:ensure:booking-ev": "node scripts/ensure-booking-ev-columns.js",
    "db:ensure:booking-ev:prod": "NODE_ENV=production node scripts/ensure-booking-ev-columns.js",
    "db:seed": "node scripts/sequelize-cli.js db:seed:all",
    "db:seed:undo": "node scripts/sequelize-cli.js db:seed:undo:all",
    "worker:notifications": "node src/modules/workers/startNotificationWorker.js",
    "reminders:requeue": "NODE_ENV=production node scripts/requeue-scheduled-reminders.js",
    "test:reminder": "NODE_ENV=production node scripts/send-test-scheduled-reminder.js"
  },
  "dependencies": {
    "@onesignal/node-onesignal": "^5.5.0",
    "@signalwire/node": "^3.0.4",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.76.4",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.2",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.2",
    "sharp": "^0.34.3",
    "signalwire": "^1.0.4",
    "socket.io": "^4.8.3",
    "stripe": "^18.4.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"

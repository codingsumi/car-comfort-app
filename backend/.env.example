NODE_ENV=development
PORT=4001

# Trust one reverse-proxy hop (Next.js rewrites, nginx, load balancer).
# Required for express-rate-limit when X-Forwarded-For is present. Set to 0 to disable.
TRUST_PROXY=1

DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=car_comfort
DB_USER=root
DB_PASSWORD=root

JWT_SECRET=replace_me_with_a_strong_secret
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_IN=15m

BCRYPT_SALT_ROUNDS=10

# Used to encrypt sensitive settings (Stripe keys, SMTP passwords, etc.)
# If not set, falls back to JWT_SECRET. Use a unique 32+ char random string in production.
SETTINGS_ENCRYPTION_KEY=
OTP_EXPIRY_MINUTES=10

DRIVER_ONBOARDING_TOTAL_STEPS=5
# If true, driver cannot submit step > current_step (prevents skipping)
DRIVER_ONBOARDING_STRICT=false

# File uploads (local disk)
UPLOAD_DIR=uploads
# Public mount path for serving uploads
UPLOAD_PUBLIC_BASE=/uploads

# Used to generate absolute file URLs in API responses & DB (recommended in prod)
# Example: https://api.yourdomain.com
PUBLIC_BASE_URL=
# Public Mapbox browser token for the customer PWA. Use a `pk.` token and
# restrict it in Mapbox to https://app.carcomfort.betaplanets.com/*.
MAPBOX_PUBLIC_ACCESS_TOKEN=
# Public Google Places browser key for the customer PWA. Restrict it to
# https://app.carcomfort.betaplanets.com/* in Google Cloud Console.
GOOGLE_PLACES_PUBLIC_API_KEY=
# Admin/public web app URL, including base path. Used for redirects such as /delete-account-request.
# Example: https://yourdomain.com/admin
ADMIN_FRONTEND_URL=http://localhost:4002/admin

# Optional: email logo image URL (absolute). If unset, falls back to PUBLIC_BASE_URL/assets/images/logo.svg or embeds SVG.
EMAIL_LOGO_URL=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Car Comfort"
MAIL_DEBUG=false

# New confirmed-booking operational alert. Set to false to disable it.
ADMIN_BOOKING_NOTIFICATION_ENABLED=true
ADMIN_BOOKING_NOTIFICATION_EMAIL=rickieweah3@gmail.com

SMS_PROVIDER=signalwire
SIGNALWIRE_PROJECT_ID=...
SIGNALWIRE_TOKEN=...
SIGNALWIRE_SPACE_URL=bluestone-apps.signalwire.com
SIGNALWIRE_FROM_NUMBER=+12082643331
# Non-production: SMS is logged to console instead of sent (set SMS_FORCE_SEND=true to use SignalWire locally)
# SMS_MOCK=true
# SMS_FORCE_SEND=false

# Optional: protect /api/auth/send-test-sms
TEST_SMS_KEY=

# Optional: protect /api/auth/apple/verify (test-only helper)
TEST_APPLE_KEY=

# Optional server env fallbacks if admin Settings → Stripe is empty:
STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → POST https://<api-host>/api/webhooks/stripe
# Subscribe to (see STRIPE_WEBHOOK_EVENT_TYPES in src/services/stripePayoutWebhook.service.js):
# payment_intent.*, charge.refunded, refund.*, transfer.*, payout.*, account.updated, capability.updated, balance.available
STRIPE_WEBHOOK_SECRET=

# Driver app / deep links (KYC return after Stripe Connect onboarding)
DRIVER_APP_URL=carcomfort://kyc
# Optional: override Stripe Account Link URLs (defaults use PUBLIC_BASE_URL redirects)
# DRIVER_KYC_RETURN_URL=
# DRIVER_KYC_REFRESH_URL=
# App routes opened after API 302 redirect:
DRIVER_KYC_APP_SUCCESS_URL=
DRIVER_KYC_APP_ERROR_URL=
DRIVER_KYC_APP_REFRESH_URL=

#
# Google "Client ID" used to validate the *ID token* `aud` claim.
# If you support multiple apps (Android/iOS/Web), you can provide multiple client IDs as a comma-separated list.
# Example:
# GOOGLE_CLIENT_ID=8900xxxxxx-android.apps.googleusercontent.com,8900xxxxxx-web.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# Sign in with Apple: must match JWT `aud`. iOS = bundle ID (e.g. io.carcomfort.app); web = Apple Services ID.
# Use a comma-separated list if you validate both native and web tokens:
# APPLE_CLIENT_ID=io.carcomfort.app,your.services.id
APPLE_CLIENT_ID=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

PUBLIC_BASE_URL=
INVOICE_COMPANY_NAME=
INVOICE_COMPANY_ADDRESS=
INVOICE_WEBSITE=
# Shown on invoices and other support touchpoints when set; defaults to support@carcomfort.com in code if empty.
SUPPORT_EMAIL=support@carcomfort.com
SUPPORT_PHONE=
INVOICE_TAX_ID=
INVOICE_DISCLAIMER=
# IANA timezone for invoices and provider service records (e.g. America/New_York, America/Chicago)
INVOICE_TIMEZONE=America/New_York

# OneSignal (server → push). REST API Key from OneSignal Dashboard → Keys & IDs (keep secret).
# App ID and Android Channel ID are non-secret but should still be set via env per environment.
# Mobile apps must set External ID to the same string as your API user id (e.g. OneSignal.login(String(userId))).
ONESIGNAL_REST_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_ANDROID_CHANNEL_ID=
# Shared secret for POST /api/webhooks/onesignal/* (Authorization: Bearer <secret>)
ONESIGNAL_WEBHOOK_SECRET=

# Firebase Realtime Database (booking chat, support live chat, admin RTDB sync)
# Service account: Firebase Console → Project settings → Service accounts → Generate key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
# Optional: Firebase Console → Project settings → Your apps → Web app (apiKey for admin panel)
FIREBASE_WEB_API_KEY=

# Redis (BullMQ notification queue + Socket.IO adapter). Required for scheduled booking reminders.
REDIS_URL=redis://127.0.0.1:6379
# In production run a dedicated worker: npm run worker:notifications
# Or embed worker in API process: NOTIFICATION_EMBED_WORKER=true
# NOTIFICATION_EMBED_WORKER=false
# Comma-separated minutes before service for reminders (default: 1440,720,300,120,60 = 24h,12h,5h,2h,1h)
# NOTIFY_REMINDER_OFFSETS_MIN=1440,720,300,120,60

# Tutorial content for customer app (/api/tutorial)
# Instructions are pipe-separated one-line entries.
TUTORIAL_VIDEO_URL=
TUTORIAL_INSTRUCTIONS=How to request a service|Tracking your service provider in real-time|Payment and safety features
DRIVER_TUTORIAL_VIDEO_URL=
DRIVER_TUTORIAL_INSTRUCTIONS=How to view and accept jobs on your home map|Taking before and after photos and verifying the customer PIN|Using navigation to reach pickup and drop-off locations|Completing services and tracking your earnings|Staying available to receive new job requests

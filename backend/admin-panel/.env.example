# Admin panel URL (must include host + /admin path)
NEXT_PUBLIC_APP_URL=http://localhost:4002/admin
# Backend origin only — e.g. http://localhost:3000 if root .env has PORT=3000 (do NOT add /api)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=/admin

# Mapbox GL (fleet map + booking tracking map)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Firebase Realtime Database (support ticket live chat)
# Optional if the API .env has FIREBASE_DATABASE_URL — admin fetches config from GET /admin/support/firebase-config
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
